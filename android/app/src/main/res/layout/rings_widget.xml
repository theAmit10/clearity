<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rings_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/rings_widget_bg">

    <LinearLayout
        android:id="@+id/rings_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/rings_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No habits yet"
            android:textSize="12sp"
            android:textColor="#9E9E9E" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rings_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        <ImageView android:id="@+id/ring_0" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
        <ImageView android:id="@+id/ring_1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
        <ImageView android:id="@+id/ring_2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
        <ImageView android:id="@+id/ring_3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
        <ImageView android:id="@+id/ring_4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rings_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">
        <ImageView android:id="@+id/ring_5" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
        <ImageView android:id="@+id/ring_6" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
        <ImageView android:id="@+id/ring_7" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
        <ImageView android:id="@+id/ring_8" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
        <ImageView android:id="@+id/ring_9" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:contentDescription="@null" />
    </LinearLayout>

</LinearLayout>
